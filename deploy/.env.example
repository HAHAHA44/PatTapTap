# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Database password (any long random string).
POSTGRES_PASSWORD=change-me
# Secret for login tokens, at least 32 characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-change-me-change-me-change-me

# Mail. Development: leave unset to use Mailpit (http://localhost:8025).
# Production: your provider's SMTP, e.g. smtps://USER:PASS@smtp.example.com:465
# SMTP_URL=
# MAIL_FROM=PatPatTap <no-reply@example.com>

# Production only: the API's public domain (DNS must point at this machine).
# DOMAIN=api.example.com

# When the daily challenge rolls over, as a UTC offset in minutes (480 = UTC+8).
# DAILY_TZ_OFFSET_MIN=480
